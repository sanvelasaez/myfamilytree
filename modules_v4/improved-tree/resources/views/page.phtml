<script src="<?= e($module->assetUrl('js/improved-tree.js')) ?>"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Full-viewport view: stop the underlying page from scrolling behind it.
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';

        const graphUrl          = <?= json_encode($graph_url) ?>;
        const svg               = document.getElementById('itree-svg');
        const consanguinityDeg  = document.getElementById('itree-consanguinity-degree');
        const levelControls     = document.getElementById('itree-level-controls');
        const ancestorDepth     = document.getElementById('itree-ancestor-depth');
        const descendantDepth   = document.getElementById('itree-descendant-depth');
        const includeSiblings   = document.getElementById('itree-include-siblings');
        const includeSpouses    = document.getElementById('itree-include-spouses');
        const showPhotos        = document.getElementById('itree-show-photos');
        const refreshBtn        = document.getElementById('itree-refresh');
        const centerBtn         = document.getElementById('itree-center');
        const zoomInBtn         = document.getElementById('itree-zoom-in');
        const zoomOutBtn        = document.getElementById('itree-zoom-out');
        const toggleBtn         = document.getElementById('itree-toggle');
        const shell             = document.getElementById('itree-fs');
        const closeBtn          = document.getElementById('itree-close');

        const renderer = new window.ImprovedTree.TreeRenderer(svg);

        function isConsanguinityMode() {
            return parseInt(consanguinityDeg.value, 10) > 0;
        }

        function updateLevelControlsVisibility() {
            levelControls.style.display = isConsanguinityMode() ? 'none' : '';
        }

        function currentParams() {
            const params = {
                consanguinity_degree: consanguinityDeg.value,
                include_spouses: includeSpouses.checked ? '1' : '0',
                show_photos: showPhotos.checked ? '1' : '0',
            };
            if (!isConsanguinityMode()) {
                params.ancestor_depth   = ancestorDepth.value;
                params.descendant_depth = descendantDepth.value;
                params.include_siblings = includeSiblings.checked ? '1' : '0';
            }
            return params;
        }

        function loadGraph() {
            renderer.loadGraph(graphUrl, currentParams());
        }

        consanguinityDeg.addEventListener('change', function () {
            updateLevelControlsVisibility();
            loadGraph();
        });

        refreshBtn.addEventListener('click', loadGraph);
        ancestorDepth.addEventListener('change', loadGraph);
        descendantDepth.addEventListener('change', loadGraph);
        includeSiblings.addEventListener('change', loadGraph);
        includeSpouses.addEventListener('change', loadGraph);
        showPhotos.addEventListener('change', loadGraph);

        centerBtn.addEventListener('click', function () {
            renderer.centerOnRoot();
        });
        zoomInBtn.addEventListener('click', function () {
            renderer.zoomIn();
        });
        zoomOutBtn.addEventListener('click', function () {
            renderer.zoomOut();
        });

        toggleBtn.addEventListener('click', function () {
            const open = shell.classList.toggle('itree-fs--options-open');
            toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeBtn.click();
            }
        });

        updateLevelControlsVisibility();
        loadGraph();
    });
</script>
